# Direwolf with the config APRS-X writes from its settings (Config.direwolf_managed).
# Install as a user unit: ~/.config/systemd/user/aprsx-direwolf.service
[Unit]
Description=Direwolf soundcard TNC (config written by APRS-X)
After=sound.target

[Service]
# stdbuf: Direwolf block-buffers stdout when it isn't a TTY, hiding its log.
ExecStart=/usr/bin/stdbuf -oL /usr/bin/direwolf -t 0 -c %h/.config/aprsx/direwolf.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
