# Direwolf with the config APRS-X writes from its settings (Config.direwolf_managed).
# Installed by install.sh as a user unit: ~/.config/systemd/user/aprsx-direwolf.service
[Unit]
Description=Direwolf soundcard TNC (config written by APRS-X)
After=sound.target
# Until "Manage Direwolf" is turned on in the settings there is no config, and
# Direwolf stays stopped. The core writes it and restarts this unit.
ConditionPathExists=%h/.config/aprsx/direwolf.conf

[Service]
# stdbuf: Direwolf block-buffers stdout when it isn't a TTY, hiding its log.
# -a 30: the receive noise level every 30 s, for the status page (audiomon.py).
ExecStart=/usr/bin/stdbuf -oL /usr/bin/direwolf -t 0 -a 30 -c %h/.config/aprsx/direwolf.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
